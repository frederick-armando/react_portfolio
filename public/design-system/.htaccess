RewriteEngine On

# Redirect ds.frederickarmando.fr → https://frederickarmando.fr/design-system
RewriteCond %{HTTP_HOST} ^ds\.frederickarmando\.fr$ [NC]
RewriteRule ^(.*)$ https://frederickarmando.fr/design-system [R=301,L]

# SPA fallback: serve index.html for any unmatched route under /design-system
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
